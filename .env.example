# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Google Gemini API key — enables the summary + structured-extraction layer.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.6-flash)
# DOC_GEMINI_MODEL=gemini-3.6-flash

# Optional: OCR engine for keyword fusion — "tesseract" (default) or "surya"
# DOC_OCR_ENGINE=tesseract
